          <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="#1B1F24" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Surface0Brush" Color="#15171B" />
          <SolidColorBrush x:Key="Surface1Brush" Color="#1D2025" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#191B20" />
