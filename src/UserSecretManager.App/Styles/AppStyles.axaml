<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Surface0Brush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector=":is(TextBlock).muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector=":is(TextBlock).danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- Chips / badges -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Border.chip.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.accent > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Border.chip.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.warning > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.chip.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.danger > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Border.chip.success">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.success > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.chip.outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.chip.outline > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- Notices -->
  <Style Selector="Border.notice">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.notice.info">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.notice.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningSoftBrush}" />
  </Style>
  <Style Selector="Border.notice.error">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerSoftBrush}" />
  </Style>
  <Style Selector="PathIcon.info">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="PathIcon.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="PathIcon.error">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.subtle, ToggleButton.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <Style Selector="ToggleButton.subtle:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.subtle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- Tabs -->
  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,0" />
  </Style>

  <!-- Lists -->
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.plain > ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="TreeView.sidebar TreeViewItem">
    <Setter Property="MinHeight" Value="30" />
  </Style>
</Styles>
