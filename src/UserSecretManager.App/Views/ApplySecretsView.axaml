<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UserSecretManager.App.ViewModels"
             xmlns:v="using:UserSecretManager.App.Views"
             x:Class="UserSecretManager.App.Views.ApplySecretsView"
             x:DataType="vm:ApplySecretsViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20,16,20,14">

    <!-- Mode -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
      <RadioButton GroupName="applyMode" IsChecked="{Binding Replace}" Content="Değiştir (secrets.json = bu değerler)" />
      <RadioButton GroupName="applyMode" IsChecked="{Binding !Replace}" Content="Birleştir (mevcut secret'ların üzerine yaz)" />
    </StackPanel>

    <!-- Context and warnings -->
    <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,10">
      <TextBlock Text="{Binding Details}" IsVisible="{Binding HasDetails}" Classes="caption" TextWrapping="Wrap" />
      <Border Classes="notice warning" IsVisible="{Binding HasWarning}">
        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="notice info" IsVisible="{Binding IsAlreadyApplied}">
        <TextBlock Text="{Binding AlreadyAppliedText}" TextWrapping="Wrap" />
      </Border>
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="Medium" IsVisible="{Binding CanApply}" />
      <Border Classes="notice warning" IsVisible="{Binding ReplaceDeletesSecrets}">
        <TextBlock Text="{Binding DeleteWarning}" TextWrapping="Wrap" />
      </Border>
      <TextBlock Text="{Binding Error}" Classes="danger" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <!-- Segmented switch -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
        <ToggleButton IsChecked="{Binding IsSecretsTab, Mode=OneWay}" Command="{Binding ShowSecretsCommand}">
          <TextBlock Text="Secret'lar" />
        </ToggleButton>
        <ToggleButton IsChecked="{Binding IsDiffTab, Mode=OneWay}" Command="{Binding ShowDiffCommand}">
          <TextBlock Text="Dosya farkı" />
        </ToggleButton>
      </StackPanel>
      <ToggleButton Grid.Column="2" Classes="subtle" IsChecked="{Binding RevealValues}" IsVisible="{Binding IsSecretsTab}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource IconEye}" />
          <TextBlock Text="Değerleri göster" />
        </StackPanel>
      </ToggleButton>
    </Grid>

    <!-- Secrets -->
    <Border Grid.Row="3" Classes="card" ClipToBounds="True" IsVisible="{Binding IsSecretsTab}">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource Surface0Brush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" MinHeight="30" Padding="12,0">
          <Grid ColumnDefinitions="2*,3*,110">
            <TextBlock Grid.Column="0" Text="ANAHTAR" Classes="section" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="DEĞER" Classes="section" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="DURUM" Classes="section" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <ListBox Grid.Row="1" Classes="plain" ItemsSource="{Binding Rows}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:SecretChangeRowViewModel">
              <Grid ColumnDefinitions="2*,3*,110" Margin="12,6">
                <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="mono" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayValue}" Classes="mono" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding DisplayPreviousValue}" Classes="mono caption" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding HasPreviousValue}" />
                </StackPanel>
                <Panel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                  <Border Classes="chip warning" IsVisible="{Binding IsChanged}">
                    <TextBlock Text="{Binding StatusText}" />
                  </Border>
                  <Border Classes="chip accent" IsVisible="{Binding IsAdded}">
                    <TextBlock Text="{Binding StatusText}" />
                  </Border>
                  <Border Classes="chip danger" IsVisible="{Binding IsRemoved}">
                    <TextBlock Text="{Binding StatusText}" />
                  </Border>
                  <Border Classes="chip outline" IsVisible="{Binding IsNeutral}">
                    <TextBlock Text="{Binding StatusText}" />
                  </Border>
                </Panel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Diff -->
    <v:ChangePreviewView Grid.Row="3" DataContext="{Binding Preview}"
                         IsVisible="{Binding $parent[UserControl].((vm:ApplySecretsViewModel)DataContext).IsDiffTab}" />

    <!-- Footer -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <TextBlock Grid.Column="0" Text="{Binding CountsText}" FontWeight="Medium" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Kapat" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Classes="primary" Content="Uygula" Command="{Binding ApplyCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
