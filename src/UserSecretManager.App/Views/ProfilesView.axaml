<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UserSecretManager.App.ViewModels"
             x:Class="UserSecretManager.App.Views.ProfilesView"
             x:DataType="vm:ProfilesTabViewModel">
  <Border Classes="card" Margin="0,8,0,12" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*">
      <Border Grid.Row="0" Classes="toolbar" CornerRadius="6,6,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap"
                     Text="Profil, aynı secret anahtarlarının farklı değerlerle adlandırılmış ve şifreli bir kopyasıdır (ör. Local, Staging DB). Değerleri profilde düzenleyin, sonra profili uygulayarak secrets.json'ı tek adımda değiştirin." />
          <Button Grid.Column="1" Classes="primary" Margin="12,0,0,0" Command="{Binding CreateCommand}"
                  IsEnabled="{Binding IsAvailable}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconPlus}" Foreground="White" />
              <TextBlock Text="Yeni profil…" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="notice error" CornerRadius="0"
              IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
      </Border>

      <Panel Grid.Row="2">
        <ListBox Classes="plain" ItemsSource="{Binding Profiles}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:ProfileRowViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,10">
                <PathIcon Grid.Column="0" Data="{StaticResource IconKey}" VerticalAlignment="Top" Margin="0,2,12,0"
                          Foreground="{DynamicResource AccentBrush}" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <Border Classes="chip success" IsVisible="{Binding IsActive}"
                            ToolTip.Tip="secrets.json şu anda bu profille birebir aynı">
                      <TextBlock Text="Etkin" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Classes="muted"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Details}" Classes="caption" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Button Command="{Binding EditCommand}" ToolTip.Tip="Profilin adını ve secret değerlerini düzenle">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconEdit}" />
                      <TextBlock Text="Düzenle" />
                    </StackPanel>
                  </Button>
                  <Button Classes="icon" Command="{Binding OverwriteCommand}"
                          ToolTip.Tip="Profil değerlerini şu anki secrets.json ile değiştir">
                    <PathIcon Data="{StaticResource IconSave}" />
                  </Button>
                  <Button Classes="icon" Command="{Binding DeleteCommand}" ToolTip.Tip="Profili sil">
                    <PathIcon Data="{StaticResource IconDelete}" />
                  </Button>
                  <Button Command="{Binding ApplyCommand}" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Uygula…" />
                      <PathIcon Data="{StaticResource IconArrowRight}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock IsVisible="{Binding IsEmpty}" Classes="muted" Margin="24" TextWrapping="Wrap"
                   Text="Henüz profil yok. Şu anki secret'ları veya bir ortamın (ör. Staging) değerlerini profil olarak kaydedebilirsiniz." />
        <TextBlock IsVisible="{Binding IsUnavailable}" Text="{Binding UnavailableMessage}" Classes="muted" Margin="24"
                   TextWrapping="Wrap" />
      </Panel>
    </Grid>
  </Border>
</UserControl>
