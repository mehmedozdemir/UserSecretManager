<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UserSecretManager.App.ViewModels"
             x:Class="UserSecretManager.App.Views.SecretsView"
             x:DataType="vm:SecretsTabViewModel">

  <UserControl.Styles>
    <Style Selector="ListBox.secrets > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="TextBox.cellEditor">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.deleted TextBox">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="IsReadOnly" Value="True" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card" Margin="0,8,0,12" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

      <!-- Toolbar -->
      <Border Grid.Row="0" Classes="toolbar" CornerRadius="6,6,0,0">
        <Grid ColumnDefinitions="260,*,Auto">
          <TextBox Grid.Column="0" Watermark="Secret ara…" Text="{Binding Filter}" VerticalAlignment="Center">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource IconSearch}" Margin="8,0,0,0" Opacity="0.6" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0" Spacing="4">
            <ToggleButton Classes="subtle" IsChecked="{Binding RevealAll}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconEye}" />
                <TextBlock Text="Tümünü göster" />
              </StackPanel>
            </ToggleButton>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button Command="{Binding AddSecretCommand}" IsEnabled="{Binding LoadError, Converter={x:Static ObjectConverters.IsNull}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconPlus}" />
                <TextBlock Text="Yeni secret" />
              </StackPanel>
            </Button>
            <DropDownButton ToolTip.Tip="Dışa/içe aktarma ve şablon">
              <TextBlock Text="Aktarım" />
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Dışa aktar (parolalı)…" Command="{Binding ExportCommand}" />
                  <MenuItem Header="İçe aktar…" Command="{Binding ImportCommand}" />
                  <Separator />
                  <MenuItem Header="secrets.template.json oluştur / güncelle…" Command="{Binding WriteTemplateCommand}" />
                  <MenuItem Header="Şablondaki eksik anahtarları ekle" Command="{Binding FillFromTemplateCommand}"
                            IsEnabled="{Binding HasTemplate}" />
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <Button Command="{Binding MoveBackCommand}"
                    ToolTip.Tip="Seçili secret'ları bir appsettings dosyasına geri yaz (önce değişiklikleri kaydedin)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconUndo}" />
                <TextBlock Text="appsettings'e geri taşı…" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- File info -->
      <Border Grid.Row="1" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
              IsVisible="{Binding HasFilePath}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="DOSYA" Classes="section" VerticalAlignment="Center" />
          <SelectableTextBlock Text="{Binding FilePath}" Classes="caption mono" VerticalAlignment="Center" />
          <Border Classes="chip outline" IsVisible="{Binding !FileExists}">
            <TextBlock Text="henüz oluşturulmadı" />
          </Border>
          <Button Classes="icon" Padding="3" MinHeight="18" MinWidth="18" Command="{Binding CopyPathCommand}"
                  ToolTip.Tip="Yolu kopyala">
            <PathIcon Data="{StaticResource IconCopy}" Width="11" Height="11" />
          </Button>
          <Button Classes="icon" Padding="3" MinHeight="18" MinWidth="18" Command="{Binding OpenFolderCommand}"
                  IsVisible="{Binding FileExists}" ToolTip.Tip="Klasörü aç">
            <PathIcon Data="{StaticResource IconFolder}" Width="11" Height="11" />
          </Button>
        </StackPanel>
      </Border>

      <!-- Header -->
      <Border Grid.Row="2" Background="{DynamicResource Surface0Brush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1" MinHeight="32" Padding="0,0,12,0">
        <Grid ColumnDefinitions="40,2*,3*,110,132">
          <TextBlock Grid.Column="1" Text="ANAHTAR" Classes="section" VerticalAlignment="Center" Margin="4,0" />
          <TextBlock Grid.Column="2" Text="DEĞER" Classes="section" VerticalAlignment="Center" Margin="12,0" />
          <TextBlock Grid.Column="3" Text="DURUM" Classes="section" VerticalAlignment="Center" Margin="8,0" />
        </Grid>
      </Border>

      <!-- Rows -->
      <Panel Grid.Row="3">
        <ListBox Classes="plain secrets" ItemsSource="{Binding Rows}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:SecretRowViewModel">
              <Grid ColumnDefinitions="40,2*,3*,110,132" Margin="0,4,12,4" Classes.deleted="{Binding IsDeleted}">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding !IsNew}"
                          Margin="10,0,0,0" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="4,0" VerticalAlignment="Center">
                  <TextBox Classes="mono cellEditor" Text="{Binding Key}" Watermark="Section:Key" />
                  <TextBlock Text="{Binding KeyError}" IsVisible="{Binding HasKeyError}" Classes="danger"
                             FontSize="11.5" Margin="2,2,0,0" />
                </StackPanel>
                <TextBox Grid.Column="2" Classes="mono cellEditor" Margin="12,0,0,0" VerticalAlignment="Top"
                         Text="{Binding Value}" PasswordChar="•" RevealPassword="{Binding IsRevealed}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="8,0" VerticalAlignment="Top">
                  <Border Classes="chip accent" IsVisible="{Binding IsNew}" Margin="0,5,0,0">
                    <TextBlock Text="{Binding StatusText}" />
                  </Border>
                  <Border Classes="chip warning" IsVisible="{Binding IsModified}" Margin="0,5,0,0">
                    <TextBlock Text="{Binding StatusText}" />
                  </Border>
                  <Border Classes="chip danger" IsVisible="{Binding IsDeleted}" Margin="0,5,0,0">
                    <TextBlock Text="{Binding StatusText}" />
                  </Border>
                  <Border Classes="chip outline" IsVisible="{Binding IsOrphan}" Margin="0,5,0,0"
                          ToolTip.Tip="Bu anahtar hiçbir appsettings dosyasında yok">
                    <TextBlock Text="Sahipsiz" />
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top"
                            HorizontalAlignment="Right">
                  <ToggleButton Classes="icon" IsChecked="{Binding IsRevealed}" ToolTip.Tip="Göster / gizle">
                    <PathIcon Data="{StaticResource IconEye}" />
                  </ToggleButton>
                  <Button Classes="icon" Command="{Binding CopyValueCommand}" ToolTip.Tip="Değeri kopyala">
                    <PathIcon Data="{StaticResource IconCopy}" />
                  </Button>
                  <Button Classes="icon" Command="{Binding CopyKeyCommand}" ToolTip.Tip="Anahtarı kopyala">
                    <PathIcon Data="{StaticResource IconKey}" />
                  </Button>
                  <Button Classes="icon" Command="{Binding ToggleDeleteCommand}" ToolTip.Tip="{Binding DeleteToolTip}">
                    <Panel>
                      <PathIcon Data="{StaticResource IconDelete}" IsVisible="{Binding !IsDeleted}" />
                      <PathIcon Data="{StaticResource IconUndo}" IsVisible="{Binding IsDeleted}" />
                    </Panel>
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock IsVisible="{Binding IsEmpty}" Text="{Binding EmptyMessage}" Classes="muted" TextWrapping="Wrap"
                   Margin="52,24" VerticalAlignment="Top" />
      </Panel>

      <!-- Footer -->
      <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Summary}" FontWeight="Medium" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding DiscardCommand}">
              <TextBlock Text="Vazgeç" />
            </Button>
            <Button Classes="primary" Command="{Binding SaveCommand}" HotKey="Ctrl+S" ToolTip.Tip="Kaydet (Ctrl+S)">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconSave}" Foreground="White" />
                <TextBlock Text="Kaydet…" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
