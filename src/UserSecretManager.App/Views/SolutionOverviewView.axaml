<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UserSecretManager.App.ViewModels"
             x:Class="UserSecretManager.App.Views.SolutionOverviewView"
             x:DataType="vm:SolutionOverviewViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="20,16,20,14">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding Name}" Classes="h1" />
          <Border Classes="chip outline">
            <TextBlock Text="Solution" />
          </Border>
        </StackPanel>
        <SelectableTextBlock Text="{Binding Path}" Classes="caption mono" />
        <TextBlock Text="{Binding Summary}" Classes="muted" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="card" Margin="12,12,12,12" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource Surface0Brush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" MinHeight="32" Padding="14,0">
          <Grid ColumnDefinitions="2*,2*,3*,90,90,120">
            <TextBlock Grid.Column="0" Text="PROJE" Classes="section" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="ORTAMLAR" Classes="section" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="USERSECRETSID" Classes="section" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="SECRET" Classes="section" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="ÖNERİ" Classes="section" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Panel Grid.Row="1">
          <ListBox Classes="plain" ItemsSource="{Binding Projects}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:SolutionProjectRowViewModel">
                <Grid ColumnDefinitions="2*,2*,3*,90,90,120" Margin="14,8">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="danger" FontSize="11.5"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding EnvironmentsText}" Classes="muted" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SecretsIdText}" Classes="mono" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SharedText}" IsVisible="{Binding IsShared}" FontSize="11.5"
                               Foreground="{DynamicResource WarningBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding SecretCount}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding SuggestedCount}" VerticalAlignment="Center" />
                  <Button Grid.Column="5" Command="{Binding OpenCommand}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Aç" />
                      <PathIcon Data="{StaticResource IconArrowRight}" />
                    </StackPanel>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock IsVisible="{Binding IsEmpty}" Text="Bu solution'da proje bulunamadı." Classes="muted" Margin="24" />
        </Panel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
